SECRET_KEY=change-me-in-local-and-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Kaka Motors <studio@kakamotors.local>

# Leave empty to use local SQLite. Railway provides this automatically.
DATABASE_URL=

# Cloudflare R2 — files go here; only image_url is stored in Railway Postgres
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_ENDPOINT_URL=
CLOUDFLARE_R2_PUBLIC_BASE_URL=

# Optional: Cloudflare Image Resizing origin, e.g. https://kakamotors.com/cdn-cgi/image
CLOUDFLARE_IMAGE_RESIZE_BASE=

# Optional runtime error reporting
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
